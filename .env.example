# CareNest configuration (placeholders only - never commit real secrets)

# Server
PORT=8787
NODE_ENV=development
DATABASE_FILE=./data/carenest.db
SESSION_DAYS=30
SESSION_SECRET=replace-with-a-long-random-string

# Reminder scheduler
# Set REMINDERS_ENABLED=false to pause background reminder generation.
REMINDERS_ENABLED=true
# How often the in-process scheduler ticks (seconds).
REMINDER_TICK_SECONDS=30
# Demo/test mode writes reminders to the local delivery log instead of sending email.
EMAIL_MODE=test

# Transactional email (only used when EMAIL_MODE=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CareNest <no-reply@example.com>"
APP_BASE_URL=http://localhost:5173

# Comma-separated emails allowed to reset demo data (optional)
DEMO_ADMIN_EMAILS=
